{
  "name": "minimi-research-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Conversational research agent with temporal memory, web search, and evidence-based comparison",
  "author": {
    "name": "Kushal",
    "url": "https://github.com/Kushal1213"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --experimental-sqlite --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "pretest": "node -e \"require('node:fs').mkdirSync('.vitest-tmp',{recursive:true})\"",
    "test": "cross-env TMP=.vitest-tmp TEMP=.vitest-tmp node --experimental-sqlite ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env TMP=.vitest-tmp TEMP=.vitest-tmp node --experimental-sqlite ./node_modules/vitest/vitest.mjs",
    "start": "node --experimental-sqlite dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
